<Window x:Class="Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1"
        mc:Ignorable="d"
        Title="CG1 - Image Filtering"
        Height="720" Width="1280"
        MinHeight="400" MinWidth="600">

    <DockPanel>

        <ToolBar DockPanel.Dock="Top" Height="36">
            <Button x:Name="LoadButton" Content="📂  Load Image" Click="LoadButton_Click" Padding="10,4" FontSize="13"/>
            <Separator/>
            <Button x:Name="SaveButton" Content="💾  Save Result" Click="SaveButton_Click" Padding="10,4" FontSize="13" IsEnabled="False"/>
            <Separator/>
            <Button x:Name="ResetButton" Content="↺  Reset" Click="ResetButton_Click" Padding="10,4" FontSize="13" IsEnabled="False"/>
            <Separator/>
            <Button x:Name="OpenEditorButton" Content="✏  Filter Editor" Click="OpenEditorButton_Click" Padding="10,4" FontSize="13"/>
            <Separator/>
            <Button x:Name="OpenDitheringButton" Content="🎨  Dithering" Click="OpenDitheringButton_Click" Padding="10,4" FontSize="13"/>
        </ToolBar>

        <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel x:Name="FiltersPanel" Orientation="Horizontal"/>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="No image loaded." FontSize="12"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Background="#E0E0E0" Padding="4,2">
                    <TextBlock Text="Original" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#2B2B2B">
                    <Image x:Name="OriginalImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#A0A0A0" ShowsPreview="True"/>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="#E0E0E0" Padding="4,2">
                    <TextBlock Text="Result" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#2B2B2B">
                    <Image x:Name="ResultImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>
                </ScrollViewer>
            </DockPanel>

        </Grid>
    </DockPanel>
</Window>

